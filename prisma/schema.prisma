generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
}

enum Role {
  SUPERADMIN
  ADMIN
  USER
}

enum ActivityAction {
  AUTH_LOGIN
  AUTH_LOGOUT
  AUTH_PASSWORD_RESET_REQUEST
  AUTH_PASSWORD_RESET_COMPLETE
  CREATE
  UPDATE
  DELETE
  ASSIGN
  UNASSIGN
  CONTROL_OVERRIDE
  FIREBASE_SYNC
  ALERT_SENT
}

enum IrrigationMode {
  AUTO
  MANUAL
}

enum RelayState {
  OFF
  ON
}

enum MoistureStatus {
  KERING
  LEMBAB
  BASAH
}

enum AlertSeverity {
  INFO
  WARNING
  CRITICAL
}

enum SyncStatus {
  PENDING
  SYNCED
  FAILED
}

enum AlertTargetType {
  REGION
  BLOCK
  SPRAYER
}

model User {
  id                   String                  @id @default(cuid())
  email                String                  @unique @db.VarChar(254)
  name                 String                  @db.VarChar(100)
  passwordHash         String                  @map("password_hash") @db.VarChar(255)
  role                 Role                    @default(USER)
  isActive             Boolean                 @default(true) @map("is_active")
  deletedAt            DateTime?               @map("deleted_at")
  createdAt            DateTime                @default(now()) @map("created_at")
  updatedAt            DateTime                @updatedAt @map("updated_at")
  profile              UserProfile?
  sessions             Session[]
  passwordResetTokens  PasswordResetToken[]
  administeredRegions  AdminRegionAssignment[] @relation("AdminRegionAssignments")
  assignedRegions      UserRegionAssignment[]  @relation("UserRegionAssignments")
  assignedAdminRegions AdminRegionAssignment[] @relation("AdminRegionAssignedBy")
  assignedUserRegions  UserRegionAssignment[]  @relation("UserRegionAssignedBy")
  createdRegions       Region[]                @relation("RegionCreator")
  updatedRegions       Region[]                @relation("RegionUpdater")
  createdBlocks        Block[]                 @relation("BlockCreator")
  updatedBlocks        Block[]                 @relation("BlockUpdater")
  thresholds           IndicatorThreshold[]
  activityLogs         ActivityLog[]           @relation("ActorActivityLogs")
  irrigationEvents     IrrigationEvent[]       @relation("IrrigationActor")
  alertNotifications   AlertNotification[]     @relation("AlertRecipient")
  sentEmails           EmailDelivery[]         @relation("EmailRecipient")

  @@index([role, createdAt])
  @@index([isActive, createdAt])
  @@index([deletedAt])
  @@map("user")
}

model Session {
  id                String    @id @default(cuid())
  userId            String    @map("user_id")
  tokenHash         String    @unique @map("token_hash") @db.VarChar(64)
  expiresAt         DateTime  @map("expires_at")
  absoluteExpiresAt DateTime? @map("absolute_expires_at")
  lastSeenAt        DateTime  @default(now()) @map("last_seen_at")
  ipAddress         String?   @map("ip_address") @db.VarChar(64)
  userAgent         String?   @map("user_agent") @db.VarChar(512)
  createdAt         DateTime  @default(now()) @map("created_at")
  user              User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@index([absoluteExpiresAt])
  @@index([lastSeenAt])
  @@map("session")
}

model PasswordResetToken {
  id        String    @id @default(cuid())
  userId    String    @map("user_id")
  tokenHash String    @unique @map("token_hash") @db.VarChar(64)
  expiresAt DateTime  @map("expires_at")
  usedAt    DateTime? @map("used_at")
  createdAt DateTime  @default(now()) @map("created_at")
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@map("password_reset_token")
}

model Region {
  id                 String                  @id @default(cuid())
  name               String                  @unique @db.VarChar(100)
  description        String?                 @db.VarChar(1000)
  latitude           Decimal?                @db.Decimal(18, 16)
  longitude          Decimal?                @db.Decimal(19, 16)
  volumeDivider      Decimal                 @default(1) @map("volume_divider") @db.Decimal(10, 4)
  showWindDirection  Boolean                 @default(true) @map("show_wind_direction")
  showAutoIrrigation Boolean                 @default(true) @map("show_auto_irrigation")
  dryMaxPercent      Int                     @default(40) @map("dry_max_percent")
  wetMinPercent      Int                     @default(80) @map("wet_min_percent")
  automaticMode      Boolean                 @default(false) @map("automatic_mode")
  safetyTimeoutMin   Int                     @default(1) @map("safety_timeout_min")
  safetyTimeoutMax   Int                     @default(3) @map("safety_timeout_max")
  createdById        String                  @map("created_by_id")
  updatedById        String?                 @map("updated_by_id")
  firebaseSyncStatus SyncStatus              @default(PENDING) @map("firebase_sync_status")
  firebaseSyncedAt   DateTime?               @map("firebase_synced_at")
  createdAt          DateTime                @default(now()) @map("created_at")
  updatedAt          DateTime                @updatedAt @map("updated_at")
  createdBy          User                    @relation("RegionCreator", fields: [createdById], references: [id])
  updatedBy          User?                   @relation("RegionUpdater", fields: [updatedById], references: [id])
  blocks             Block[]
  adminAssignments   AdminRegionAssignment[]
  userAssignments    UserRegionAssignment[]
  thresholds         IndicatorThreshold[]
  mapLayers          MapLayer[]
  activityLogs       ActivityLog[]

  @@index([createdById])
  @@index([firebaseSyncStatus, createdAt])
  @@map("region")
}

model ContactSubmission {
  id        String   @id @default(cuid())
  name      String   @db.VarChar(100)
  email     String   @db.VarChar(254)
  phone     String?  @db.VarChar(32)
  userType  String?  @map("user_type") @db.VarChar(64)
  message   String   @db.Text
  isRead    Boolean  @default(false) @map("is_read")
  createdAt DateTime @default(now()) @map("created_at")

  @@index([createdAt])
  @@index([isRead])
  @@index([isRead, createdAt])
  @@map("contact_submission")
}

model Block {
  id                 String     @id @default(cuid())
  regionId           String     @map("region_id")
  name               String     @db.VarChar(100)
  areaHectare        Decimal?   @map("area_hectare") @db.Decimal(10, 2)
  polygonGeojson     Json?      @map("polygon_geojson")
  createdById        String     @map("created_by_id")
  updatedById        String?    @map("updated_by_id")
  firebaseSyncStatus SyncStatus @default(PENDING) @map("firebase_sync_status")
  firebaseSyncedAt   DateTime?  @map("firebase_synced_at")
  createdAt          DateTime   @default(now()) @map("created_at")
  updatedAt          DateTime   @updatedAt @map("updated_at")
  region             Region     @relation(fields: [regionId], references: [id], onDelete: Cascade)
  createdBy          User       @relation("BlockCreator", fields: [createdById], references: [id])
  updatedBy          User?      @relation("BlockUpdater", fields: [updatedById], references: [id])
  sprayers           Sprayer[]

  @@unique([regionId, name])
  @@index([createdById])
  @@map("block")
}

model Sprayer {
  id                 String            @id @default(cuid())
  blockId            String            @map("block_id")
  hardwareId         String            @map("hardware_id") @db.VarChar(100)
  displayName        String            @map("display_name") @db.VarChar(100)
  installedAt        DateTime?         @map("installed_at")
  isActive           Boolean           @default(true) @map("is_active")
  firebaseSyncStatus SyncStatus        @default(PENDING) @map("firebase_sync_status")
  firebaseSyncedAt   DateTime?         @map("firebase_synced_at")
  createdAt          DateTime          @default(now()) @map("created_at")
  updatedAt          DateTime          @updatedAt @map("updated_at")
  block              Block             @relation(fields: [blockId], references: [id], onDelete: Cascade)
  sensorReadings     SensorReading[]
  irrigationEvents   IrrigationEvent[]

  @@unique([blockId, hardwareId])
  @@index([blockId])
  @@index([blockId, isActive])
  @@map("sprayer")
}

model AdminRegionAssignment {
  adminId      String   @map("admin_id")
  regionId     String   @map("region_id")
  assignedById String   @map("assigned_by_id")
  assignedAt   DateTime @default(now()) @map("assigned_at")
  admin        User     @relation("AdminRegionAssignments", fields: [adminId], references: [id], onDelete: Cascade)
  assignedBy   User     @relation("AdminRegionAssignedBy", fields: [assignedById], references: [id])
  region       Region   @relation(fields: [regionId], references: [id], onDelete: Cascade)

  @@id([adminId, regionId])
  @@index([regionId])
  @@index([assignedById])
  @@map("admin_region_assignment")
}

model UserRegionAssignment {
  userId       String   @map("user_id")
  regionId     String   @map("region_id")
  assignedById String   @map("assigned_by_id")
  assignedAt   DateTime @default(now()) @map("assigned_at")
  user         User     @relation("UserRegionAssignments", fields: [userId], references: [id], onDelete: Cascade)
  assignedBy   User     @relation("UserRegionAssignedBy", fields: [assignedById], references: [id])
  region       Region   @relation(fields: [regionId], references: [id], onDelete: Cascade)

  @@id([userId, regionId])
  @@index([regionId])
  @@index([assignedById])
  @@map("user_region_assignment")
}

model IndicatorThreshold {
  id                     String         @id @default(cuid())
  userId                 String         @map("user_id")
  regionId               String         @map("region_id")
  displayDryMaxPercent   Int            @default(40) @map("display_dry_max_percent")
  displayMoistMaxPercent Int            @default(70) @map("display_moist_max_percent")
  displayWetMinPercent   Int            @default(80) @map("display_wet_min_percent")
  landPreference         MoistureStatus @default(LEMBAB) @map("land_preference")
  createdAt              DateTime       @default(now()) @map("created_at")
  updatedAt              DateTime       @updatedAt @map("updated_at")
  user                   User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  region                 Region         @relation(fields: [regionId], references: [id], onDelete: Cascade)

  @@unique([userId, regionId])
  @@index([regionId])
  @@map("indicator_threshold")
}

model SensorReading {
  id               String         @id @default(cuid())
  sprayerId        String         @map("sprayer_id")
  sourceKey        String         @map("source_key") @db.VarChar(191)
  moisturePercent  Decimal        @map("moisture_percent") @db.Decimal(5, 2)
  flowLmin         Decimal        @map("flow_lmin") @db.Decimal(8, 2)
  totalVolumeLiter Decimal?       @map("total_volume_liter") @db.Decimal(12, 2)
  moistureStatus   MoistureStatus @map("moisture_status")
  pumpStatus       String         @map("pump_status") @db.VarChar(16)
  windDirection    String?        @map("wind_direction") @db.VarChar(100)
  recordedAt       DateTime       @map("recorded_at")
  createdAt        DateTime       @default(now()) @map("created_at")
  sprayer          Sprayer        @relation(fields: [sprayerId], references: [id], onDelete: Cascade)

  @@unique([sprayerId, sourceKey])
  @@index([sprayerId, recordedAt])
  @@index([recordedAt])
  @@map("sensor_reading")
}

model IrrigationEvent {
  id               String         @id @default(cuid())
  sprayerId        String         @map("sprayer_id")
  actorId          String?        @map("actor_id")
  mode             IrrigationMode
  relay            RelayState
  reason           String?        @db.VarChar(255)
  durationSeconds  Int?           @map("duration_seconds")
  totalVolumeLiter Decimal?       @map("total_volume_liter") @db.Decimal(12, 2)
  firebaseEventId  String?        @unique @map("firebase_event_id") @db.VarChar(512)
  firebaseDateKey  String?        @map("firebase_date_key") @db.VarChar(64)
  startedAt        DateTime       @map("started_at")
  endedAt          DateTime?      @map("ended_at")
  createdAt        DateTime       @default(now()) @map("created_at")
  sprayer          Sprayer        @relation(fields: [sprayerId], references: [id], onDelete: Cascade)
  actor            User?          @relation("IrrigationActor", fields: [actorId], references: [id], onDelete: SetNull)

  @@index([sprayerId, startedAt])
  @@index([sprayerId, relay, endedAt])
  @@index([mode, startedAt])
  @@index([actorId])
  @@index([firebaseDateKey])
  @@index([startedAt, id])
  @@map("irrigation_event")
}

model MapLayer {
  id        String   @id @default(cuid())
  regionId  String   @map("region_id")
  name      String   @db.VarChar(100)
  geojson   Json
  isDefault Boolean  @default(false) @map("is_default")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  region    Region   @relation(fields: [regionId], references: [id], onDelete: Cascade)

  @@unique([regionId, name])
  @@map("map_layer")
}

model ActivityLog {
  id         String         @id @default(cuid())
  actorId    String?        @map("actor_id")
  regionId   String?        @map("region_id")
  action     ActivityAction
  entityType String         @map("entity_type") @db.VarChar(64)
  entityId   String?        @map("entity_id") @db.VarChar(191)
  metadata   Json?
  ipAddress  String?        @map("ip_address") @db.VarChar(64)
  userAgent  String?        @map("user_agent") @db.VarChar(512)
  createdAt  DateTime       @default(now()) @map("created_at")
  actor      User?          @relation("ActorActivityLogs", fields: [actorId], references: [id], onDelete: SetNull)
  region     Region?        @relation(fields: [regionId], references: [id], onDelete: SetNull)

  @@index([actorId, createdAt])
  @@index([regionId, createdAt])
  @@index([action, createdAt])
  @@index([createdAt])
  @@index([entityType, createdAt])
  @@map("activity_log")
}

model AlertNotification {
  id          String                   @id @default(cuid())
  recipientId String?                  @map("recipient_id")
  severity    AlertSeverity
  title       String                   @db.VarChar(191)
  message     String                   @db.Text
  deliveredAt DateTime?                @map("delivered_at")
  readAt      DateTime?                @map("read_at")
  createdAt   DateTime                 @default(now()) @map("created_at")
  recipient   User?                    @relation("AlertRecipient", fields: [recipientId], references: [id], onDelete: SetNull)
  target      AlertNotificationTarget?

  @@index([recipientId, createdAt])
  @@index([severity, createdAt])
  @@map("alert_notification")
}

model AlertNotificationTarget {
  alertId    String            @id @map("alert_id")
  targetType AlertTargetType   @map("target_type")
  targetId   String            @map("target_id") @db.VarChar(191)
  alert      AlertNotification @relation(fields: [alertId], references: [id], onDelete: Cascade)

  @@index([targetType, targetId])
  @@map("alert_notification_target")
}

model EmailDelivery {
  id          String    @id @default(cuid())
  recipientId String?   @map("recipient_id")
  toEmail     String    @map("to_email") @db.VarChar(254)
  subject     String    @db.VarChar(200)
  provider    String    @db.VarChar(32)
  providerId  String?   @map("provider_id") @db.VarChar(255)
  sentAt      DateTime? @map("sent_at")
  failedAt    DateTime? @map("failed_at")
  error       String?   @db.Text
  createdAt   DateTime  @default(now()) @map("created_at")
  recipient   User?     @relation("EmailRecipient", fields: [recipientId], references: [id], onDelete: SetNull)

  @@index([recipientId, createdAt])
  @@index([toEmail, createdAt])
  @@index([createdAt])
  @@map("email_delivery")
}

model SystemSetting {
  key       String   @id
  value     Json
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("system_setting")
}

model LandingTestimonial {
  id        String   @id @default(cuid())
  name      String
  role      String   @db.VarChar(120)
  quote     String   @db.Text
  imageUrl  String?  @map("image_url") @db.VarChar(2048)
  sortOrder Int      @default(0) @map("sort_order")
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([isActive, sortOrder])
  @@map("landing_testimonial")
}

model LandingLocation {
  id          String   @id @default(cuid())
  name        String
  description String   @db.Text
  imageUrl    String?  @map("image_url") @db.VarChar(2048)
  sortOrder   Int      @default(0) @map("sort_order")
  isActive    Boolean  @default(true) @map("is_active")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@index([isActive, sortOrder])
  @@map("landing_location")
}

model LandingPartner {
  id         String   @id @default(cuid())
  name       String
  logoUrl    String?  @map("logo_url") @db.VarChar(2048)
  websiteUrl String?  @map("website_url") @db.VarChar(2048)
  sortOrder  Int      @default(0) @map("sort_order")
  isActive   Boolean  @default(true) @map("is_active")
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  @@index([isActive, sortOrder])
  @@map("landing_partner")
}

model NewsletterSubscriber {
  id             String    @id @default(cuid())
  email          String    @unique @db.VarChar(254)
  subscribedAt   DateTime  @default(now()) @map("subscribed_at")
  isActive       Boolean   @default(true) @map("is_active")
  unsubscribedAt DateTime? @map("unsubscribed_at")

  @@index([isActive, subscribedAt])
  @@map("newsletter_subscriber")
}

model UserProfile {
  userId         String    @id @map("user_id")
  whatsapp       String?   @db.VarChar(32)
  nickname       String?   @db.VarChar(100)
  gender         String?   @db.VarChar(32)
  birthDate      DateTime? @map("birth_date")
  altPhone       String?   @map("alt_phone") @db.VarChar(32)
  occupation     String?   @db.VarChar(120)
  domicile       String?   @db.VarChar(120)
  address        String?   @db.VarChar(500)
  country        String?   @db.VarChar(100)
  province       String?   @db.VarChar(100)
  city           String?   @db.VarChar(100)
  postalCode     String?   @map("postal_code") @db.VarChar(20)
  internalNotes  String?   @map("internal_notes") @db.Text
  deviceUsername String?   @unique @map("device_username") @db.VarChar(100)
  apiKey         String?   @unique @map("api_key") @db.VarChar(255)
  updatedAt      DateTime  @updatedAt @map("updated_at")
  user           User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("user_detail")
}

model LoginThrottle {
  key           String    @id @db.VarChar(128)
  failures      Int       @default(0)
  level         Int       @default(0)
  cooldownUntil DateTime? @map("cooldown_until")
  lastEventAt   DateTime  @default(now()) @map("last_event_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")

  @@index([lastEventAt])
  @@map("login_throttle")
}

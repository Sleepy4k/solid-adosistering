# Copy this file to .env and fill in real values. Never commit .env.
# Variables prefixed with VITE_ are embedded in the browser bundle. Never put
# database passwords, SMTP credentials, or Firebase service-account keys there.

# ---------------------------------------------------------------------------
# Database (required at runtime)
# ---------------------------------------------------------------------------
DATABASE_URL="mysql://root:change-me@127.0.0.1:3306/adosistering"

# ---------------------------------------------------------------------------
# Application / sessions
# ---------------------------------------------------------------------------
# Exact public origin. Required in production; used for CSRF and absolute URLs.
APP_ORIGIN="http://localhost:3000"
# Public URL baked into canonical, Open Graph, sitemap, and robots output at build time.
# Set this to the final HTTPS URL before `bun run build`.
VITE_SITE_URL="http://localhost:3000"
VITE_APP_NAME="Adosistering"
VITE_TWITTER_HANDLE="@adosistering"
VITE_CONTACT_EMAIL="adosisteringteam@gmail.com"
# Base cookie name. Production automatically applies the __Host- prefix.
SESSION_COOKIE_NAME="adosistering_session"
# Set true only when a trusted reverse proxy overwrites X-Forwarded-For.
TRUST_PROXY="false"

# ---------------------------------------------------------------------------
# Firebase Admin SDK (server only)
# ---------------------------------------------------------------------------
FIREBASE_PROJECT_ID=""
FIREBASE_CLIENT_EMAIL=""
FIREBASE_PRIVATE_KEY=""
FIREBASE_DATABASE_URL=""
FIREBASE_SYNC_DISABLED="false"
# Optional: a complete service-account JSON object on one line. Takes precedence
# over the four fields above when set.
FIREBASE_SERVICE_ACCOUNT_JSON=""

# ---------------------------------------------------------------------------
# Firebase client SDK (public identifiers only)
# ---------------------------------------------------------------------------
VITE_FIREBASE_API_KEY=""
VITE_FIREBASE_AUTH_DOMAIN=""
VITE_FIREBASE_DATABASE_URL=""
VITE_FIREBASE_PROJECT_ID=""
VITE_FIREBASE_APP_ID=""
# reCAPTCHA site key for Firebase App Check. Enable App Check enforcement in
# the Firebase Console for Realtime Database before relying on it.
VITE_FIREBASE_APP_CHECK_SITE_KEY=""

# ---------------------------------------------------------------------------
# SMTP
# ---------------------------------------------------------------------------
SMTP_HOST="smtp.gmail.com"
SMTP_PORT="465"
SMTP_SECURE="true"
SMTP_USER="adosisteringteam@gmail.com"
SMTP_PASS=""
EMAIL_FROM="Adosistering <adosisteringteam@gmail.com>"
# Keep true in production. Disabling certificate verification exposes mail
# credentials and message contents to interception.
SMTP_TLS_REJECT_UNAUTHORIZED="true"

# ---------------------------------------------------------------------------
# Uploads
# ---------------------------------------------------------------------------
# Private runtime directory. Served through /uploads/cms/<filename>; never place
# this under public/ and never serve it directly from the reverse proxy.
UPLOAD_DIR=".data/uploads"
UPLOAD_MAX_BYTES="2097152"

# ---------------------------------------------------------------------------
# Seeding (only used by `bun run db:seed`)
# ---------------------------------------------------------------------------
# Required for production seeding unless all role-specific overrides below are set.
# SEED_PASSWORD=""
# Optional role-specific overrides:
# SEED_SUPERADMIN_PASSWORD=""
# SEED_ADMIN_PASSWORD=""
# SEED_USER_PASSWORD=""

# ---------------------------------------------------------------------------
# Optional local/demo fallback (not needed in normal deployments)
# ---------------------------------------------------------------------------
# VITE_APP_CONFIGURED="false"
# VITE_DEFAULT_REGION_NAME="MAOS"
# VITE_DEFAULT_BLOCK_NAME="Block_A"
# VITE_DEFAULT_SPRAYER_ID=""
# VITE_DEFAULT_DRY_MAX_PERCENT="40"
# VITE_DEFAULT_WET_MIN_PERCENT="80"
